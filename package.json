{
  "name": "build-size-diff",
  "version": "1.2.0",
  "description": "GitHub Action for bundle size tracking across any bundler (Vite, Webpack, Rollup, esbuild, Parcel)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-actions",
    "bundle-size",
    "performance",
    "ci-cd",
    "vite",
    "webpack",
    "rollup",
    "esbuild",
    "parcel",
    "nextjs",
    "nuxt",
    "astro",
    "svelte",
    "sveltekit",
    "turbopack",
    "rspack",
    "monorepo",
    "code-review",
    "pull-request",
    "pr-comment",
    "gzip",
    "brotli",
    "compression",
    "budget",
    "size-limit",
    "bundler-agnostic",
    "performance-monitoring",
    "frontend-tooling",
    "build-tools",
    "continuous-integration",
    "developer-experience"
  ],
  "author": "step-security",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/build-size-diff.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/build-size-diff/issues"
  },
  "homepage": "https://github.com/step-security/build-size-diff#readme",
  "dependencies": {
    "@actions/artifact": "^6.0.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "esbuild": "0.28.2",
    "typescript": "~7.0.2"
  }
}
